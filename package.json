{
  "name": "shapeshyft_api",
  "version": "1.0.154",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "bun run dist/index.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write src",
    "format:check": "bunx prettier --check src",
    "db:init": "bun run src/db/init.ts",
    "verify": "bun run typecheck && bun run lint && bun run test:unit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:setup": "./scripts/setup-test-db.sh"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@types/sharp": "~0.32.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.39.0",
    "@google/generative-ai": "~0.21.0",
    "@hono/zod-validator": "~0.7.6",
    "@sudobility/auth_service": "^1.1.30",
    "@sudobility/entity_service": "^1.0.50",
    "@sudobility/ratelimit_service": "^1.0.48",
    "@sudobility/shapeshyft_engine": "^1.0.13",
    "@sudobility/shapeshyft_service": "^1.0.13",
    "@sudobility/shapeshyft_types": "^1.1.18",
    "@sudobility/subscription_service": "^1.0.32",
    "@sudobility/types": "^1.9.76",
    "drizzle-orm": "~0.45.4",
    "firebase-admin": "~13.10.0",
    "groq-sdk": "~0.37.0",
    "hono": "~4.11.5",
    "openai": "~4.104.0",
    "postgres": "~3.4.9",
    "sharp": "~0.35.5",
    "zod": "~3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/shapeshyft_api.git"
  }
}
