{
  "name": "shapeshyft_api",
  "version": "1.0.148",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "bun run dist/index.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx eslint src",
    "typecheck": "bunx tsc --noEmit",
    "format": "bunx prettier --write src",
    "format:check": "bunx prettier --check src",
    "db:init": "bun run src/db/init.ts",
    "verify": "bun run typecheck && bun run lint && bun run test:unit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:setup": "./scripts/setup-test-db.sh"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "@hono/zod-validator": "^0.7.5",
    "@sudobility/auth_service": "^1.1.27",
    "@sudobility/entity_service": "^1.0.47",
    "@sudobility/ratelimit_service": "^1.0.45",
    "@sudobility/shapeshyft_engine": "^1.0.12",
    "@sudobility/shapeshyft_service": "^1.0.12",
    "@sudobility/shapeshyft_types": "^1.1.13",
    "@sudobility/subscription_service": "^1.0.29",
    "@sudobility/types": "^1.9.74",
    "drizzle-orm": "^0.45.0",
    "firebase-admin": "^13.6.0",
    "groq-sdk": "^0.37.0",
    "hono": "^4.10.7",
    "openai": "^4.77.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.4",
    "zod": "^3.24.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/shapeshyft_api.git"
  }
}
